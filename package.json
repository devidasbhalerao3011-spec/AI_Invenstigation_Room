{
  "name": "investigation-room",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @investigation-room/api\" \"npm run dev -w @investigation-room/web\"",
